# Custom ignored
.vscode
build/*
docs/_build
.DS_Store
__pycache__
*.pyc
.ipynb_checkpoints

# Prerequisites
*.d

# Compiled Object files
*.slo
*.lo
*.o
*.obj

# Precompiled Headers
*.gch
*.pch

