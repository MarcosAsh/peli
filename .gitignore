*.so
*.dylib
*.dll

# Fortran module files
*.mod
*.smod

# Compiled Static libraries
*.lai
*.la
*.a
*.lib

# Executables
*.exe
*.out
*.app

python/build/
python/*egg-info/
python/dist/

# Local Modal/dev tooling — never committed
tools/modal/
.modal/

# IDE / clangd cache
.cache/
compile_commands.json

# wheel build artifacts (scikit-build-core writes to build/, also dist/)
dist/

tests/data/corpus/

# mkdocs build output
site/
